# Gemini API Key (optional if users provide per-request BYOK key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Connection (Postgres via Neon/Supabase or SQLite for local dev)
# Unset this variable to disable audit persistence gracefully without crashing.
DATABASE_URL=postgresql://user:password@ep-cool-site-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional API Key Authentication & Rate Limiting
# Set to 'true' to enforce X-API-Key headers and per-key rate limits for hosted multi-tenant setups.
# Default is 'false' for single-user self-hosted mode.
REQUIRE_AUTH=false

