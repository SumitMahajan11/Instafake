# ==============================================================================
# ReelClaim Environment Configuration
# Copy this file to .env before running `docker compose up` or local setup.
# ==============================================================================

# Gemini API Key (Required for server-side single-user mode; optional if clients pass per-request BYOK key)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Optional; defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Database URL for Audit Persistence (Optional; PostgreSQL connection string. Unset to run in stateless mode)
DATABASE_URL=postgresql://reelclaim:reelclaim_pass@postgres:5432/reelclaim

# Require API Key Authentication (Optional; set to 'true' to enforce X-API-Key auth and rate limits, 'false' for single-user mode)
REQUIRE_AUTH=false

# Backend Port (Optional; defaults to 8000)
PORT=8000

# Frontend Next.js Public Backend API URL (Required for client API requests)
NEXT_PUBLIC_API_URL=http://localhost:8000
